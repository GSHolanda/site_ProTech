---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import { pagina404, seo, site } from "../data/site";
import { linkWhatsApp } from "../lib/whatsapp";
---

<BaseLayout title={seo.erro404.title} description={seo.erro404.description} noindex>
  <section class="on-dark relative isolate overflow-hidden bg-black" aria-labelledby="erro-titulo">
    <div class="grid-tecnica absolute inset-0 -z-10 [mask-image:linear-gradient(to_bottom,black,transparent)]" aria-hidden="true"></div>
    <div class="wrap flex min-h-[70vh] flex-col justify-center py-20">
      <p class="eyebrow mb-6">{pagina404.selo}</p>
      <h1 id="erro-titulo" class="text-6xl sm:text-8xl">{pagina404.titulo}</h1>
      <p class="mt-6 max-w-xl text-lg text-steel-200 sm:text-xl">{pagina404.texto}</p>
      <div class="mt-10 flex flex-col gap-3 sm:flex-row">
        <Button href="/" icone="seta" iconeFim tamanho="lg">Voltar ao início</Button>
        <Button href="/cambio-dsg" variante="contorno-claro" tamanho="lg">Câmbio DSG</Button>
        <Button href={linkWhatsApp(site.mensagens.padrao)} externo variante="contorno-claro" icone="whatsapp" tamanho="lg">
          Falar no WhatsApp
        </Button>
      </div>
    </div>
  </section>
</BaseLayout>
