---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/home/Hero.astro";
import Especialidades from "../components/home/Especialidades.astro";
import Servicos from "../components/home/Servicos.astro";
import DsgDestaque from "../components/home/DsgDestaque.astro";
import ComoFunciona from "../components/home/ComoFunciona.astro";
import Diferenciais from "../components/home/Diferenciais.astro";
import Casos from "../components/home/Casos.astro";
import Avaliacoes from "../components/home/Avaliacoes.astro";
import Sobre from "../components/home/Sobre.astro";
import CtaContato from "../components/CtaContato.astro";
import { seo } from "../data/site";
---

<BaseLayout title={seo.home.title} description={seo.home.description}>
