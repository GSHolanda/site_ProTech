---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import SectionHeading from "../components/SectionHeading.astro";
import Sintomas from "../components/Sintomas.astro";
import Passos from "../components/Passos.astro";
import ModelosLista from "../components/ModelosLista.astro";
import Faq from "../components/Faq.astro";
import CtaContato from "../components/CtaContato.astro";
import { paginaDsg as p, seo } from "../data/site";
import { comCodigos } from "../lib/texto";
import { schemaBreadcrumb, schemaFaq, schemaServico } from "../lib/schema";

const schemas = [
  schemaFaq(p.faq.itens),
  schemaBreadcrumb([
    { nome: "Início", caminho: "/" },
    { nome: p.nomeCurto, caminho: "/cambio-dsg" },
  ]),
  schemaServico("Reparo de câmbio DSG e mecatrônica DQ200 e DQ250", seo.dsg.description, "/cambio-dsg"),
];
---

<BaseLayout title={seo.dsg.title} description={seo.dsg.description} schemas={schemas}>
  <PageHero
    selo={p.selo}
    titulo={p.titulo}
    introducao={p.introducao}
    nomeCurto={p.nomeCurto}
    servicoWhatsApp={p.servicoWhatsApp}
    ctaWhatsApp={p.ctaWhatsApp}
    ancora={{ href: "#sintomas", rotulo: "Ver sintomas" }}
  />

  <!-- O que é o DSG -->
  <section class="section-y bg-white" aria-labelledby="o-que-e-titulo">
    <div class="wrap grid gap-10 lg:grid-cols-[minmax(0,22rem)_1fr] lg:gap-16">
      <SectionHeading selo="Entenda" titulo={p.oQueE.titulo} id="o-que-e-titulo" />
      <div class="max-w-3xl space-y-5 text-lg text-steel-700">
        {p.oQueE.paragrafos.map((t) => <p set:html={comCodigos(t)} />)}
      </div>
    </div>
  </section>

  <!-- DQ200 x DQ250 -->
  <section class="section-y bg-steel-50" aria-labelledby="comparativo-titulo">
    <div class="wrap">
      <SectionHeading selo="Comparativo" titulo={p.comparativo.titulo} texto={p.comparativo.introducao} id="comparativo-titulo" />
      <div class="mt-10 overflow-hidden rounded-[3px] border border-steel-200 bg-white">
        <table class="w-full border-collapse text-left">
          <caption class="sr-only">Comparação entre os câmbios DSG DQ200 e DQ250</caption>
          <thead>
            <tr class="border-b-2 border-steel-900">
              <td class="w-[30%] p-3 sm:w-[28%] sm:p-5"></td>
              {
                p.comparativo.colunas.map((c) => (
                  <th scope="col" class="p-3 font-display text-2xl font-bold sm:p-5 sm:text-4xl" set:html={comCodigos(c)} />
                ))
              }
            </tr>
          </thead>
          <tbody>
            {
              p.comparativo.linhas.map((linha) => (
                <tr class="border-b border-steel-200 last:border-0">
                  <th scope="row" class="p-3 align-top font-mono text-[0.7rem] leading-6 font-medium tracking-[0.1em] text-steel-600 uppercase sm:p-5 sm:text-xs">
                    {linha.rotulo}
                  </th>
                  {linha.valores.map((v) => (
                    <td class="p-3 align-top sm:p-5 sm:text-lg" set:html={comCodigos(v)} />
                  ))}
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <Sintomas titulo={p.sintomas.titulo} itens={p.sintomas.itens} />

  <!-- Diagnóstico -->
  <section class="section-y bg-white" aria-labelledby="diagnostico-titulo">
    <div class="wrap">
      <SectionHeading selo="Diagnóstico" titulo={p.diagnostico.titulo} id="diagnostico-titulo" />
      <Passos passos={p.diagnostico.passos} class="mt-12" />
    </div>
  </section>

  <ModelosLista
    titulo={p.modelos.titulo}
    itens={p.modelos.itens}
    nota={p.modelos.nota}
    servicoWhatsApp={p.servicoWhatsApp}
  />

  <Faq titulo={p.faq.titulo} perguntas={p.faq.itens} />

  <CtaContato
    id="orcamento-dsg"
    selo="Orçamento"
    titulo={p.cta.titulo}
    texto={p.cta.texto}
    servico={p.servicoWhatsApp}
  />
</BaseLayout>
