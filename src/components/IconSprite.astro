---
/** Desenhos de todos os ícones, uma vez por página. Ver Icon.astro. */
import { preenchidos, tracados } from "./icones";

const todos = { ...preenchidos, ...tracados };
---

<svg width="0" height="0" class="absolute" aria-hidden="true" focusable="false">
  {
    Object.entries(todos).map(([nome, d]) => (
      <symbol id={`i-${nome}`} viewBox="0 0 24 24">
        <path d={d} />
      </symbol>
    ))
  }
</svg>
