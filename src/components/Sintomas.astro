---
/** Bloco escuro com os sintomas que levam ao diagnóstico. */
import { comCodigos } from "../lib/texto";
import SectionHeading from "./SectionHeading.astro";

interface Props {
  titulo: string;
  itens: ({ titulo: string; texto: string } | string)[];
  id?: string;
}

const { titulo, itens, id = "sintomas" } = Astro.props;
---

<section id={id} class="on-dark section-y bg-steel-950" aria-labelledby={`${id}-titulo`}>
  <div class="wrap">
    <SectionHeading selo="Sintomas" titulo={titulo} id={`${id}-titulo`} />
    <ul class:list={["mt-12 grid gap-px border border-white/12 bg-white/12", itens.length === 4 ? "sm:grid-cols-2 xl:grid-cols-4" : "sm:grid-cols-2 lg:grid-cols-3"]}>
      {
        itens.map((item) =>
          typeof item === "string" ? (
            <li class="flex gap-4 bg-steel-950 p-6">
              <span class="mt-2.5 size-2 shrink-0 bg-accent" aria-hidden="true" />
              <span class="text-lg text-steel-100" set:html={comCodigos(item)} />
            </li>
          ) : (
            <li class="bg-steel-950 p-6 sm:p-7">
              <span class="block h-0.5 w-8 bg-accent" aria-hidden="true" />
              <h3 class="mt-5 text-[1.7rem]">{item.titulo}</h3>
              <p class="mt-2 text-steel-300" set:html={comCodigos(item.texto)} />
            </li>
          ),
        )
      }
    </ul>
  </div>
</section>
