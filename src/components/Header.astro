---
import { site } from "../data/site";
import { linkWhatsApp } from "../lib/whatsapp";
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";

interface Props {
  /** Caminho da página atual, para marcar o item ativo do menu */
  atual?: string;
}

const { atual = "/" } = Astro.props;
const whatsapp = linkWhatsApp(site.mensagens.padrao);
---

<header class="on-dark no-print sticky top-0 z-50 border-b border-white/10 bg-black">
  <div class="wrap flex h-16 items-center justify-between gap-4">
    <a href="/" class="-ml-1 flex min-h-12 items-center px-1" aria-label={`${site.nome}, página inicial`}>
      <Logo tamanho={38} contorno />
    </a>

    <nav aria-label="Principal" class="hidden lg:block">
      <ul class="flex items-center gap-1">
        {
          site.menu.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={item.href === atual ? "page" : undefined}
                class="flex min-h-12 items-center px-3 font-display text-[1.05rem] font-semibold tracking-[0.06em] text-steel-200 uppercase transition-colors hover:text-white aria-[current=page]:text-white aria-[current=page]:underline aria-[current=page]:decoration-accent aria-[current=page]:decoration-2 aria-[current=page]:underline-offset-8"
              >
                {item.rotulo}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={whatsapp}
        target="_blank"
        rel="noopener"
        class="hidden min-h-11 items-center gap-2 rounded-[3px] bg-accent px-4 font-display text-[1.02rem] font-semibold tracking-[0.05em] text-on-accent uppercase transition-colors hover:bg-accent-hover sm:inline-flex"
      >
        <Icon nome="whatsapp" class="size-[1.15rem]" />
        Chamar no WhatsApp<span class="sr-only"> (abre em nova aba)</span>
      </a>

      <button
        type="button"
        class="-mr-2 inline-flex size-12 items-center justify-center text-white lg:hidden"
        aria-expanded="false"
        aria-controls="menu-mobile"
        data-menu-botao
      >
        <span class="sr-only" data-menu-rotulo>Abrir menu</span>
        <Icon nome="menu" class="size-6" />
      </button>
    </div>
  </div>

  <!-- Menu mobile -->
  <nav
    id="menu-mobile"
    aria-label="Principal"
    class="absolute inset-x-0 top-full border-b-2 border-accent bg-black shadow-[0_24px_48px_rgb(0_0_0/0.6)] lg:hidden"
    hidden
    data-menu-painel
  >
    <ul class="wrap flex flex-col py-3">
      {
        site.menu.map((item) => (
          <li class="border-b border-white/10 last:border-0">
            <a
              href={item.href}
              aria-current={item.href === atual ? "page" : undefined}
              class="flex min-h-14 items-center justify-between font-display text-2xl font-semibold tracking-[0.04em] text-white uppercase aria-[current=page]:text-accent-glow"
            >
              {item.rotulo}
              <Icon nome="seta" class="size-5 text-steel-400" />
            </a>
          </li>
        ))
      }
    </ul>
    <div class="wrap pb-5">
      <a
        href={whatsapp}
        target="_blank"
        rel="noopener"
        class="flex min-h-14 w-full items-center justify-center gap-2.5 rounded-[3px] bg-accent font-display text-lg font-semibold tracking-[0.05em] text-on-accent uppercase"
      >
        <Icon nome="whatsapp" class="size-5" />
        Chamar no WhatsApp<span class="sr-only"> (abre em nova aba)</span>
      </a>
    </div>
  </nav>
</header>

<script>
  const botao = document.querySelector<HTMLButtonElement>("[data-menu-botao]");
  const painel = document.querySelector<HTMLElement>("[data-menu-painel]");
  const rotulo = document.querySelector<HTMLElement>("[data-menu-rotulo]");

  if (botao && painel) {
    const aberto = () => botao.getAttribute("aria-expanded") === "true";

    const definir = (abrir: boolean, devolverFoco = false) => {
      botao.setAttribute("aria-expanded", String(abrir));
      painel.hidden = !abrir;
      if (rotulo) rotulo.textContent = abrir ? "Fechar menu" : "Abrir menu";
      botao.querySelector("use")?.setAttribute("href", abrir ? "#i-fechar" : "#i-menu");
      if (devolverFoco) botao.focus();
    };

    botao.addEventListener("click", () => definir(!aberto()));

    // Fecha ao escolher um item (links para âncoras da mesma página)
    painel.addEventListener("click", (e) => {
      if ((e.target as HTMLElement).closest("a")) definir(false);
    });

    // Esc fecha e devolve o foco ao botão
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && aberto()) definir(false, true);
    });

    // Clique fora do cabeçalho fecha
    document.addEventListener("click", (e) => {
      if (aberto() && !(e.target as HTMLElement).closest("header")) definir(false);
    });

    // Ao passar para a largura de computador, o menu mobile some
    matchMedia("(min-width: 64rem)").addEventListener("change", (e) => {
      if (e.matches) definir(false);
    });
  }
</script>
