---
/** Lista numerada de etapas (como funciona, diagnóstico, processo). */
import type { Passo } from "../data/site";
import { comCodigos } from "../lib/texto";

interface Props {
  passos: Passo[];
  /** Nível do título de cada etapa */
  nivel?: "h3" | "h4";
  class?: string;
}

const { passos, nivel = "h3", class: classe = "" } = Astro.props;
const Titulo = nivel;
const colunas = passos.length === 4 ? "md:grid-cols-2 xl:grid-cols-4" : "md:grid-cols-3";
---

<ol class:list={["grid gap-px overflow-hidden rounded-[3px] border border-steel-200 bg-steel-200", colunas, classe]}>
  {
    passos.map((passo, i) => (
      <li class="grid grid-cols-[2.75rem_1fr] gap-x-4 bg-white p-5 sm:p-7 md:flex md:flex-col">
        <span class="row-span-2 font-display text-4xl leading-none font-bold text-accent-ink md:text-5xl" aria-hidden="true">
          {String(i + 1).padStart(2, "0")}
        </span>
        <Titulo class="text-[1.5rem] md:mt-5 md:text-[1.6rem]">
          <span class="sr-only">Etapa {i + 1}: </span>
          {passo.titulo}
        </Titulo>
        <p class="mt-2 text-steel-600 md:mt-3" set:html={comCodigos(passo.texto)} />
      </li>
    ))
  }
</ol>
