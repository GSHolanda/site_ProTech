---
/**
 * Logo da PRO-TECH.
 * Se existir assets-cliente/logo.svg, usa o arquivo oficial.
 * TODO: substituir pelo logo oficial (hoje é um placeholder: monograma "P"
 * geométrico em círculo preto + palavra PRO-TECH).
 */
import { logoCliente } from "../lib/midia";
import { site } from "../data/site";

interface Props {
  /** Altura do monograma em pixels */
  tamanho?: number;
  /** Mostra a palavra PRO-TECH ao lado do monograma */
  comTexto?: boolean;
  /** Contorno claro no círculo, para o logo não sumir em fundo preto */
  contorno?: boolean;
  class?: string;
}

const { tamanho = 40, comTexto = true, contorno = false, class: classe = "" } = Astro.props;
---

{
  logoCliente ? (
    <img
      src={logoCliente.src}
      alt={site.nome}
      height={tamanho}
      width={Math.round((logoCliente.width / logoCliente.height) * tamanho)}
      class={classe}
    />
  ) : (
    <span class:list={["inline-flex items-center gap-2.5", classe]}>
      <svg
        width={tamanho}
        height={tamanho}
        viewBox="0 0 64 64"
        aria-hidden="true"
        focusable="false"
        class="shrink-0"
      >
        <circle
          cx="32"
          cy="32"
          r={contorno ? 31 : 32}
          fill="#000"
          stroke={contorno ? "rgb(255 255 255 / 0.35)" : undefined}
          stroke-width={contorno ? 1.5 : undefined}
        />
        <path
          fill="#fff"
          fill-rule="evenodd"
          d="M19.5 15h15a12 12 0 0 1 0 24h-7v10h-8Zm8 7.5h6.5a4.5 4.5 0 0 1 0 9h-6.5Z"
        />
      </svg>
      {comTexto && (
        <span class="font-display text-[1.45rem] leading-none font-bold tracking-[0.04em] uppercase">
          {site.nome}
        </span>
      )}
    </span>
  )
}
