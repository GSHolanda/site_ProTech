---
/** Lista de modelos atendidos + nota com chamada para o WhatsApp. */
import { comCodigos } from "../lib/texto";
import { linkServico } from "../lib/whatsapp";
import SectionHeading from "./SectionHeading.astro";
import Button from "./Button.astro";

interface Props {
  titulo: string;
  itens: string[];
  nota?: string;
  servicoWhatsApp: string;
  id?: string;
}

const { titulo, itens, nota, servicoWhatsApp, id = "modelos" } = Astro.props;
---

<section id={id} class="section-y bg-steel-50" aria-labelledby={`${id}-titulo`}>
  <div class="wrap grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:gap-16">
    <div>
      <SectionHeading selo="Modelos" titulo={titulo} id={`${id}-titulo`} />
      {nota && <p class="mt-5 max-w-xl text-lg text-steel-700" set:html={comCodigos(nota)} />}
      <Button href={linkServico(servicoWhatsApp)} externo icone="whatsapp" class="mt-8">
        Confirmar meu modelo
      </Button>
    </div>
    <ul class="grid content-start gap-px self-start border border-steel-200 bg-steel-200 sm:grid-cols-2">
      {
        itens.map((m) => (
          <li class="flex min-h-14 items-center gap-3 bg-white px-5 py-3 font-medium">
            <span class="size-1.5 shrink-0 bg-accent" aria-hidden="true" />
            <span set:html={comCodigos(m)} />
          </li>
        ))
      }
    </ul>
  </div>
</section>
