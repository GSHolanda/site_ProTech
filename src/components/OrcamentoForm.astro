---
/**
 * Formulário "Orçamento rápido".
 * Não envia nada para servidor: só monta a mensagem e abre o WhatsApp.
 * Sem JavaScript, o botão abre o WhatsApp com a mensagem padrão.
 */
import { site, contato } from "../data/site";
import { minusculaInicial, semCrases } from "../lib/texto";
import Icon from "./Icon.astro";

interface Props {
  /** Serviço já escolhido (ex.: "diagnóstico do câmbio DSG") */
  servico?: string;
  /** Prefixo para os ids dos campos, se houver mais de um formulário na página */
  id?: string;
  titulo?: string;
}

const { servico, id = "orcamento", titulo = contato.formulario.titulo } = Astro.props;
const f = contato.formulario;

const modeloMensagem = servico
  ? site.mensagens.formularioServico.replace("{servico}", minusculaInicial(semCrases(servico)))
  : site.mensagens.formulario;

// Sugestões para o campo "carro"
const sugestoes = [
  "Jetta 2.0 TSI",
  "Jetta 2.5",
  "Jetta GLI",
  "Golf TSI",
  "Golf GTI",
  "Polo TSI",
  "Tiguan 2.0 TSI",
  "UP!",
  "Passat",
  "Amarok V6",
  "Audi A3",
  "Audi A4 TFSI",
];
---

<form
  action={`https://wa.me/${site.whatsapp.principal}`}
  method="get"
  target="_blank"
  class="on-dark rounded-[3px] border border-white/12 bg-steel-900 p-5 sm:p-7"
  aria-labelledby={`${id}-titulo`}
  data-orcamento
  data-numero={site.whatsapp.principal}
  data-mensagem={modeloMensagem}
  data-mensagem-sintoma={site.mensagens.formularioSintoma}
>
  <h3 id={`${id}-titulo`} class="text-3xl">{titulo}</h3>

  <!-- Usado só sem JavaScript: abre o WhatsApp com a mensagem padrão -->
  <input type="hidden" name="text" value={site.mensagens.padrao} data-orcamento-texto />

  <div class="mt-5 flex flex-col gap-5">
    <div class="flex flex-col gap-2">
      <label for={`${id}-carro`} class="font-medium text-white">
        {f.carroLabel} <span class="text-steel-300">(obrigatório)</span>
      </label>
      <input
        id={`${id}-carro`}
        type="text"
        list={`${id}-modelos`}
        required
        autocomplete="off"
        maxlength="80"
        placeholder={f.carroPlaceholder}
        class="min-h-12 rounded-[3px] border border-white/25 bg-black px-4 text-white placeholder:text-steel-400 focus:border-accent-glow"
        data-orcamento-carro
      />
      <datalist id={`${id}-modelos`}>
        {sugestoes.map((s) => <option value={s} />)}
      </datalist>
    </div>

    <div class="flex flex-col gap-2">
      <label for={`${id}-sintoma`} class="font-medium text-white">
        {f.sintomaLabel} <span class="text-steel-300">(opcional)</span>
      </label>
      <textarea
        id={`${id}-sintoma`}
        rows="3"
        maxlength="500"
        placeholder={f.sintomaPlaceholder}
        class="rounded-[3px] border border-white/25 bg-black px-4 py-3 text-white placeholder:text-steel-400 focus:border-accent-glow"
        data-orcamento-sintoma></textarea>
    </div>

    <button
      type="submit"
      class="inline-flex min-h-14 w-full items-center justify-center gap-2.5 rounded-[3px] bg-accent px-6 font-display text-[1.15rem] font-semibold tracking-[0.05em] text-on-accent uppercase transition-colors hover:bg-accent-hover"
    >
      <Icon nome="whatsapp" class="size-5" />
      {f.botao}
    </button>
    <p class="text-sm text-steel-300">{f.nota}</p>
  </div>
</form>

<script>
  document.querySelectorAll<HTMLFormElement>("form[data-orcamento]").forEach((form) => {
    form.addEventListener("submit", (evento) => {
      evento.preventDefault();

      const carro = form.querySelector<HTMLInputElement>("[data-orcamento-carro]")?.value.trim() ?? "";
      const sintoma = form.querySelector<HTMLTextAreaElement>("[data-orcamento-sintoma]")?.value.trim() ?? "";
      const { numero = "", mensagem = "", mensagemSintoma = "" } = form.dataset;

      let texto = mensagem.replace("{carro}", carro);
      if (sintoma) texto += "\n" + mensagemSintoma.replace("{sintoma}", sintoma);

      const url = `https://wa.me/${numero}?text=${encodeURIComponent(texto)}`;
      const janela = window.open(url, "_blank");
      if (janela) janela.opener = null;
      else window.location.href = url;
    });
  });
</script>
