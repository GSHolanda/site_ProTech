---
/**
 * Seção escura de fechamento: formulário de orçamento + endereço, horário e
 * contatos. Usada no fim de todas as páginas.
 */
import { site, contato } from "../data/site";
import { formatarTelefone, linkWhatsApp } from "../lib/whatsapp";
import SectionHeading from "./SectionHeading.astro";
import OrcamentoForm from "./OrcamentoForm.astro";
import Button from "./Button.astro";
import Icon from "./Icon.astro";

interface Props {
  id?: string;
  selo?: string;
  titulo?: string;
  texto?: string;
  /** Serviço já escolhido no formulário */
  servico?: string;
}

const {
  id = "contato",
  selo = contato.selo,
  titulo = contato.titulo,
  texto = contato.texto,
  servico,
} = Astro.props;

const e = site.endereco;
const numeros = [site.whatsapp.principal, site.whatsapp.secundario];
---

<section id={id} class="on-dark section-y bg-black" aria-labelledby={`${id}-heading`}>
  <!-- Celular: título, formulário, contatos. Computador: formulário à direita. -->
  <div
    class="wrap grid gap-10 [grid-template-areas:'titulo'_'form'_'info'] lg:grid-cols-[1fr_minmax(0,32rem)] lg:gap-x-16 lg:[grid-template-areas:'titulo_form'_'info_form'] lg:grid-rows-[auto_1fr]"
  >
    <div class="[grid-area:titulo]">
      <SectionHeading selo={selo} titulo={titulo} texto={texto} id={`${id}-heading`} />
    </div>

    <div id={`${id}-orcamento`} class="scroll-mt-24 [grid-area:form] lg:self-start">
      <OrcamentoForm servico={servico} id={`${id}-form`} />
    </div>

    <div class="[grid-area:info]">
      <dl class="grid gap-8 sm:grid-cols-2">
        <div class="sm:col-span-2">
          <dt class="flex items-center gap-2 font-display text-sm font-semibold tracking-[0.12em] text-steel-300 uppercase">
            <Icon nome="pino" class="size-4" /> Endereço
          </dt>
          <dd class="mt-2">
            <address class="text-lg not-italic">
              {e.logradouro}<br />
              {e.bairro}, {e.cidade}-{e.uf} · CEP {e.cep}
            </address>
            <p class="mt-1 text-steel-300">Referência: {e.referencia}</p>
            <Button href={site.mapsUrl} externo variante="contorno-claro" icone="seta-diagonal" iconeFim class="mt-4">
              {contato.ctaMaps}
            </Button>
          </dd>
        </div>

        <div>
          <dt class="flex items-center gap-2 font-display text-sm font-semibold tracking-[0.12em] text-steel-300 uppercase">
            <Icon nome="relogio" class="size-4" /> Horário
          </dt>
          <dd class="mt-2 text-lg">{site.horario.texto}</dd>
        </div>

        <div>
          <dt class="flex items-center gap-2 font-display text-sm font-semibold tracking-[0.12em] text-steel-300 uppercase">
            <Icon nome="whatsapp" class="size-4" /> WhatsApp
          </dt>
          <dd class="mt-1">
            <ul>
              {
                numeros.map((n) => (
                  <li>
                    <a
                      href={linkWhatsApp(site.mensagens.padrao, n)}
                      target="_blank"
                      rel="noopener"
                      class="inline-flex min-h-11 items-center text-lg underline decoration-white/30 underline-offset-4 hover:decoration-accent-glow"
                    >
                      {formatarTelefone(n)}
                      <span class="sr-only"> (abre o WhatsApp em nova aba)</span>
                    </a>
                  </li>
                ))
              }
            </ul>
          </dd>
        </div>

        <div class="sm:col-span-2">
          <dt class="flex items-center gap-2 font-display text-sm font-semibold tracking-[0.12em] text-steel-300 uppercase">
            <Icon nome="instagram" class="size-4" /> Instagram
          </dt>
          <dd class="mt-1">
            <a
              href={site.instagram.url}
              target="_blank"
              rel="noopener"
              class="inline-flex min-h-11 items-center text-lg underline decoration-white/30 underline-offset-4 hover:decoration-accent-glow"
            >
              {site.instagram.usuario}<span class="sr-only"> (abre em nova aba)</span>
            </a>
          </dd>
        </div>
      </dl>
    </div>
  </div>
</section>
