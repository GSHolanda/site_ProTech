---
import { dsgDestaque } from "../../data/site";
import { comCodigos } from "../../lib/texto";
import { linkServico } from "../../lib/whatsapp";
import SectionHeading from "../SectionHeading.astro";
import Button from "../Button.astro";
---

<section class="on-dark section-y relative isolate overflow-hidden bg-black" aria-labelledby="dsg-titulo">
  <div class="grid-tecnica absolute inset-0 -z-10 [mask-image:linear-gradient(to_left,black,transparent_70%)]" aria-hidden="true"></div>
  <div class="wrap grid gap-12 lg:grid-cols-[1fr_minmax(0,30rem)] lg:items-center lg:gap-16">
    <div>
      <SectionHeading selo={dsgDestaque.selo} titulo={dsgDestaque.titulo} texto={dsgDestaque.texto} id="dsg-titulo" />
      <div class="mt-9 flex flex-col gap-3 sm:flex-row">
        <Button href="/cambio-dsg" icone="seta" iconeFim>
          {dsgDestaque.ctaPagina}
        </Button>
        <Button href={linkServico(dsgDestaque.servicoWhatsApp)} externo variante="contorno-claro" icone="whatsapp">
          {dsgDestaque.ctaWhatsApp}
        </Button>
      </div>
    </div>

    <ul class="grid grid-cols-2 gap-3 sm:gap-4">
      {
        dsgDestaque.cambios.map((c) => (
          <li class="border border-white/15 bg-steel-950 p-5 sm:p-6">
            <p class="font-display text-3xl font-bold sm:text-4xl" set:html={comCodigos(c.nome)} />
            <p class="mt-1 text-sm text-steel-300">
              código <span set:html={comCodigos(c.codigo)} />
            </p>
            <div class="my-4 h-0.5 w-10 bg-accent" aria-hidden="true" />
            <ul class="space-y-1.5 text-[0.95rem] text-steel-200 sm:text-base">
              {c.detalhes.map((d) => (
                <li>{d}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
  </div>
</section>
