---
import { Image } from "astro:assets";
import { hero, site } from "../../data/site";
import { comCodigos } from "../../lib/texto";
import { linkWhatsApp } from "../../lib/whatsapp";
import { buscarFoto } from "../../lib/midia";
import Button from "../Button.astro";
import RatingBadge from "../RatingBadge.astro";

const foto = hero.foto ? buscarFoto(hero.foto.arquivo) : null;
---

<section class="on-dark relative isolate overflow-hidden bg-black" aria-labelledby="hero-titulo">
  {
    foto ? (
      <>
        <Image
          src={foto}
          alt={hero.foto!.alt}
          widths={[640, 960, 1280, 1920]}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
          class="absolute inset-0 -z-20 size-full object-cover"
        />
        {/* Película escura para garantir contraste AA do texto sobre a foto */}
        <div class="absolute inset-0 -z-10 bg-linear-to-r from-black via-black/85 to-black/55" aria-hidden="true" />
      </>
    ) : (
      <div class="grid-tecnica absolute inset-0 -z-10 [mask-image:linear-gradient(to_bottom,black,transparent)]" aria-hidden="true" />
    )
  }

  <div class="wrap grid items-end gap-12 pt-14 pb-16 sm:pt-20 lg:grid-cols-[minmax(0,1fr)_22rem] lg:pt-28 lg:pb-24">
    <div>
      <p class="eyebrow mb-6">{hero.selo}</p>
      <h1 id="hero-titulo" class="max-w-4xl text-[3.1rem] leading-[0.95] sm:text-7xl lg:text-[5.75rem]">
        {hero.titulo}
      </h1>
      <p class="mt-6 max-w-2xl text-lg text-steel-200 sm:text-xl" set:html={comCodigos(hero.subtitulo)} />

      <RatingBadge class="mt-7" />

      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <Button href={linkWhatsApp(site.mensagens.agendar)} externo icone="whatsapp" tamanho="lg">
          {hero.ctaPrincipal}
        </Button>
        <Button href="#servicos" variante="contorno-claro" tamanho="lg">
          {hero.ctaSecundario}
        </Button>
      </div>
    </div>

    <!-- Ficha técnica: aparece a partir do tablet grande -->
    <dl class="hidden border border-white/15 bg-black/60 lg:block" aria-label="Especialidades da oficina">
      <div class="border-b border-white/15 px-5 py-3 font-mono text-xs tracking-[0.14em] text-steel-300 uppercase">
        Ficha de especialidade
      </div>
      {
        hero.ficha.map((linha) => (
          <div class="grid grid-cols-[5.5rem_1fr] gap-3 border-b border-white/10 px-5 py-3.5 last:border-0">
            <dt class="font-mono text-xs leading-6 tracking-[0.1em] text-steel-400 uppercase">{linha.rotulo}</dt>
            <dd class="text-[0.95rem] leading-6 text-white" set:html={comCodigos(linha.valor)} />
          </div>
        ))
      }
    </dl>
  </div>
</section>
