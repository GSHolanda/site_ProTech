---
import { especialidades, modelos } from "../../data/site";
---

<section class="on-dark border-y border-white/10 bg-steel-950" aria-labelledby="modelos-titulo">
  <div class="wrap py-8 sm:py-10">
    <p
      class="flex flex-wrap items-center gap-x-4 gap-y-1 font-display text-[1.9rem] leading-tight font-bold tracking-[0.03em] uppercase sm:text-5xl sm:gap-x-6"
    >
      {
        especialidades.map((item, i) => (
          <>
            {i > 0 && <span class="size-2 bg-accent sm:size-2.5" aria-hidden="true" />}
            <span>{item}</span>
          </>
        ))
      }
    </p>

    <div class="mt-7 flex flex-col gap-3 border-t border-white/10 pt-6 lg:flex-row lg:items-baseline lg:gap-8">
      <h2 id="modelos-titulo" class="shrink-0 font-mono text-xs font-medium tracking-[0.14em] text-steel-300">
        {modelos.titulo}
      </h2>
      <div>
        <ul class="flex flex-wrap gap-2">
          {
            modelos.itens.map((m) => (
              <li class="rounded-[3px] border border-white/15 px-3 py-1.5 text-[0.95rem] text-white">
                <span class="font-medium">{m.nome}</span>
                {m.detalhe && <span class="text-steel-300"> {m.detalhe}</span>}
              </li>
            ))
          }
        </ul>
        <p class="mt-3 text-sm text-steel-300">{modelos.nota}</p>
      </div>
    </div>
  </div>
</section>
