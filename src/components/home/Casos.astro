---
/**
 * Casos reais (antes e depois / vídeos).
 * Só aparece quando casos.ativo = true e existe pelo menos um caso com mídia.
 */
import { Image } from "astro:assets";
import { casos } from "../../data/site";
import { buscarFoto, buscarVideo } from "../../lib/midia";
import SectionHeading from "../SectionHeading.astro";

const itens = casos.itens
  .filter((c) => c.antes || c.depois || c.video)
  .map((c) => ({
    ...c,
    imgAntes: c.antes ? buscarFoto(c.antes.arquivo) : null,
    imgDepois: c.depois ? buscarFoto(c.depois.arquivo) : null,
    urlVideo: c.video ? buscarVideo(c.video.arquivo) : null,
    capaVideo: c.video?.capa ? buscarFoto(c.video.capa) : null,
  }));

const mostrar = casos.ativo && itens.length > 0;
---

{
  mostrar && (
    <section id="casos" class="on-dark section-y bg-black" aria-labelledby="casos-titulo">
      <div class="wrap">
        <SectionHeading selo={casos.selo} titulo={casos.titulo} id="casos-titulo" />
        <ul class="mt-12 grid gap-6 md:grid-cols-2">
          {itens.map((c) => (
            <li class="border border-white/15 bg-steel-950">
              {c.urlVideo ? (
                <video
                  controls
                  muted
                  playsinline
                  preload="none"
                  poster={c.capaVideo?.src}
                  class="aspect-[4/5] w-full bg-black object-cover"
                  aria-label={c.video!.descricao}
                >
                  <source src={c.urlVideo} type="video/mp4" />
                </video>
              ) : (
                <div class="grid grid-cols-2 gap-px bg-white/15">
                  {[
                    { img: c.imgAntes, foto: c.antes, rotulo: "Antes" },
                    { img: c.imgDepois, foto: c.depois, rotulo: "Depois" },
                  ].map(
                    (lado) =>
                      lado.img && (
                        <figure class="relative bg-black">
                          <Image
                            src={lado.img}
                            alt={lado.foto!.alt}
                            widths={[320, 640]}
                            sizes="(min-width: 768px) 25vw, 50vw"
                            loading="lazy"
                            class="aspect-square w-full object-cover"
                          />
                          <figcaption class="absolute top-3 left-3 bg-black/85 px-2 py-1 font-mono text-xs tracking-[0.12em] uppercase">
                            {lado.rotulo}
                          </figcaption>
                        </figure>
                      ),
                  )}
                </div>
              )}
              <div class="p-5">
                <h3 class="text-2xl">{c.titulo}</h3>
                <p class="mt-1 text-steel-300">{c.servico}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}
