---
import { avaliacoes, site } from "../../data/site";
import { formatarNota } from "../../lib/texto";
import SectionHeading from "../SectionHeading.astro";
import Button from "../Button.astro";
import Icon from "../Icon.astro";

// Só aparecem depoimentos com texto preenchido (nunca inventar).
const depoimentos = avaliacoes.depoimentos.filter((d) => d.texto.trim() && d.autor.trim());
const maiorContagem = Math.max(...avaliacoes.termos.map((t) => t.mencoes));
---

<section id="avaliacoes" class="section-y bg-white" aria-labelledby="avaliacoes-titulo">
  <div class="wrap">
    <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:gap-16">
      <div>
        <SectionHeading selo={avaliacoes.selo} titulo={avaliacoes.titulo} id="avaliacoes-titulo" />

        <div class="mt-8 flex items-center gap-5">
          <p class="font-display text-8xl leading-none font-bold" aria-hidden="true">
            {formatarNota(site.google.nota)}
          </p>
          <div>
            <p class="flex text-[#b88400]" role="img" aria-label={`Nota ${formatarNota(site.google.nota)} de 5`}>
              {Array.from({ length: 5 }, () => <Icon nome="estrela" class="size-6" />)}
            </p>
            <p class="mt-1 text-steel-600">{site.google.totalAvaliacoes} avaliações no Google</p>
          </div>
        </div>

        <div class="mt-9 flex flex-col gap-3 sm:flex-row">
          <Button href={site.google.urlAvaliacoes} externo variante="secundario" icone="seta-diagonal" iconeFim>
            {avaliacoes.ctaVer}
          </Button>
          <Button href={site.google.urlAvaliar} externo icone="estrela">
            {avaliacoes.ctaAvaliar}
          </Button>
        </div>
        <p class="mt-4 max-w-md text-sm text-steel-600">{avaliacoes.chamadaAvaliar}</p>
      </div>

      <div class="self-end">
        <h3 class="font-mono text-xs font-medium tracking-[0.14em] text-steel-600">{avaliacoes.termosTitulo}</h3>
        <ul class="mt-5 space-y-4">
          {
            avaliacoes.termos.map((t) => (
              <li>
                <div class="flex items-baseline justify-between gap-4">
                  <span class="font-display text-3xl font-bold uppercase">“{t.termo}”</span>
                  <span class="text-steel-600">{t.mencoes} menções</span>
                </div>
                <div class="mt-2 h-1.5 bg-steel-100" aria-hidden="true">
                  <div class="h-full bg-accent" style={`width: ${(t.mencoes / maiorContagem) * 100}%`} />
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    {
      depoimentos.length > 0 && (
        <ul class="mt-14 grid gap-5 md:grid-cols-3">
          {depoimentos.map((d) => (
            <li>
              <figure class="flex h-full flex-col rounded-[3px] border border-steel-200 bg-steel-50 p-6">
                <p class="flex text-[#b88400]" role="img" aria-label="5 estrelas">
                  {Array.from({ length: 5 }, () => (
                    <Icon nome="estrela" class="size-4" />
                  ))}
                </p>
                <blockquote class="mt-4 flex-1 text-steel-800">
                  <p>“{d.texto}”</p>
                </blockquote>
                <figcaption class="mt-5 text-sm">
                  <span class="font-semibold text-steel-900">{d.autor}</span>
                  {d.carro && <span class="text-steel-600"> · {d.carro}</span>}
                  <span class="block text-steel-600">Avaliação no Google</span>
                </figcaption>
              </figure>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</section>
