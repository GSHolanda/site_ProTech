---
import { Image } from "astro:assets";
import { sobre } from "../../data/site";
import { buscarFoto } from "../../lib/midia";
import SectionHeading from "../SectionHeading.astro";
import Logo from "../Logo.astro";

const foto = sobre.foto ? buscarFoto(sobre.foto.arquivo) : null;
---

<section id="sobre" class="section-y bg-steel-50" aria-labelledby="sobre-titulo">
  <div class="wrap grid gap-12 lg:grid-cols-2 lg:items-center lg:gap-16">
    <div>
      <SectionHeading selo={sobre.selo} titulo={sobre.titulo} id="sobre-titulo" />
      <div class="mt-6 space-y-4 text-lg text-steel-700">
        {sobre.paragrafos.map((p, i) => <p class={i === 0 ? "text-steel-900 font-medium" : undefined}>{p}</p>)}
      </div>
    </div>

    {
      foto ? (
        <Image
          src={foto}
          alt={sobre.foto!.alt}
          widths={[480, 800, 1200]}
          sizes="(min-width: 1024px) 50vw, 100vw"
          loading="lazy"
          class="aspect-[4/3] w-full rounded-[3px] object-cover"
        />
      ) : (
        <div class="on-dark relative overflow-hidden rounded-[3px] bg-black p-8 sm:p-10">
          <div class="grid-tecnica absolute inset-0" aria-hidden="true" />
          <Logo tamanho={64} comTexto={false} contorno class="relative" />
          <dl class="relative mt-10 grid grid-cols-2 gap-x-6 gap-y-8">
            {sobre.numeros.map((n) => (
              <div class="flex flex-col border-t border-white/20 pt-4">
                <dt class="text-sm text-steel-300">{n.rotulo}</dt>
                <dd class="-order-1 font-display text-4xl font-bold uppercase sm:text-5xl">{n.valor}</dd>
              </div>
            ))}
          </dl>
        </div>
      )
    }
  </div>
</section>
