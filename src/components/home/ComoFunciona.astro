---
import { comoFunciona } from "../../data/site";
import SectionHeading from "../SectionHeading.astro";
import Passos from "../Passos.astro";
import Button from "../Button.astro";
---

<section class="section-y bg-white" aria-labelledby="como-funciona-titulo">
  <div class="wrap">
    <SectionHeading selo={comoFunciona.selo} titulo={comoFunciona.titulo} id="como-funciona-titulo" />
    <Passos passos={comoFunciona.passos} class="mt-12" />
    <Button href="#contato-orcamento" icone="whatsapp" class="mt-10">
      {comoFunciona.cta}
    </Button>
  </div>
</section>
