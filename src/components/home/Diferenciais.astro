---
import { diferenciais } from "../../data/site";
import SectionHeading from "../SectionHeading.astro";
---

<section class="section-y bg-steel-50" aria-labelledby="diferenciais-titulo">
  <div class="wrap">
    <SectionHeading selo={diferenciais.selo} titulo={diferenciais.titulo} id="diferenciais-titulo" />
    <ul class="mt-10 grid gap-4 sm:mt-12 sm:grid-cols-2 sm:gap-5">
      {
        diferenciais.itens.map((item) => (
          <li class="border-l-4 border-accent bg-white p-5 sm:p-8">
            <h3 class="text-[1.75rem]">{item.titulo}</h3>
            <p class="mt-3 text-steel-600">{item.texto}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
