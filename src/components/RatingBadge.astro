---
import { site } from "../data/site";
import { formatarNota } from "../lib/texto";
import Icon from "./Icon.astro";

interface Props {
  class?: string;
}

const { class: classe = "" } = Astro.props;
const nota = formatarNota(site.google.nota);
---

<a
  href={site.google.urlAvaliacoes}
  target="_blank"
  rel="noopener"
  class:list={[
    "inline-flex min-h-12 items-center gap-3 rounded-[3px] border border-white/15 bg-white/5 px-4 py-2 text-sm text-white transition-colors hover:border-white/40",
    classe,
  ]}
>
  <span class="flex text-[#fbbc04]" aria-hidden="true">
    {Array.from({ length: 5 }, () => <Icon nome="estrela" class="size-4" />)}
  </span>
  <span>
    <strong class="font-display text-lg font-bold">{nota}</strong> no Google
    <span aria-hidden="true" class="px-1 text-steel-400">·</span>
    {site.google.totalAvaliacoes} avaliações
  </span>
  <span class="sr-only"> (abre as avaliações no Google em nova aba)</span>
</a>
