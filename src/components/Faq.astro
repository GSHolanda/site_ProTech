---
/** Perguntas frequentes em acordeão (sem JavaScript). */
import type { PerguntaFaq } from "../data/site";
import { comCodigos } from "../lib/texto";
import SectionHeading from "./SectionHeading.astro";
import Icon from "./Icon.astro";

interface Props {
  titulo: string;
  perguntas: PerguntaFaq[];
  id?: string;
}

const { titulo, perguntas, id = "faq" } = Astro.props;
---

<section id={id} class="section-y bg-white" aria-labelledby={`${id}-titulo`}>
  <div class="wrap grid gap-10 lg:grid-cols-[minmax(0,22rem)_1fr] lg:gap-16">
    <SectionHeading selo="Dúvidas" titulo={titulo} id={`${id}-titulo`} />
    <div class="border-t border-steel-200">
      {
        perguntas.map((p, i) => (
          <details class="group border-b border-steel-200" open={i === 0}>
            <summary class="flex min-h-16 cursor-pointer list-none items-center justify-between gap-6 py-5 [&::-webkit-details-marker]:hidden">
              <span class="text-lg font-medium text-steel-900 sm:text-xl" set:html={comCodigos(p.pergunta)} />
              <Icon nome="mais" class="size-5 shrink-0 text-accent-ink transition-transform duration-200 group-open:rotate-45" />
            </summary>
            <p class="max-w-3xl pb-6 text-steel-700" set:html={comCodigos(p.resposta)} />
          </details>
        ))
      }
    </div>
  </div>
</section>
