---
import { site } from "../data/site";
import { linkWhatsApp } from "../lib/whatsapp";
import Icon from "./Icon.astro";
---

<!--
  Botão flutuante de WhatsApp. 56px de área de toque, canto inferior direito.
  O rodapé tem um respiro extra no fim para ele nunca cobrir conteúdo.
-->
<a
  href={linkWhatsApp(site.mensagens.padrao)}
  target="_blank"
  rel="noopener"
  aria-label="Conversar com a PRO-TECH no WhatsApp (abre em nova aba)"
  class="no-print fixed right-4 bottom-4 z-40 inline-flex size-14 items-center justify-center rounded-full bg-accent text-on-accent shadow-[0_6px_20px_rgb(0_0_0/0.35)] ring-2 ring-white/90 transition-transform duration-150 hover:scale-105 hover:bg-accent-hover sm:right-6 sm:bottom-6"
  style="--focus-ring: var(--accent-ink)"
>
  <Icon nome="whatsapp" class="size-7" />
</a>
